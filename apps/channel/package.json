{
  "name": "channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Practice Agent: the practice coordinator, living in Telegram, via CopilotKit Channels.",
  "scripts": {
    "dev": "node --env-file=../../.env --experimental-sqlite --import tsx --watch src/index.ts",
    "start": "node --env-file=../../.env --experimental-sqlite --import tsx src/index.ts",
    "seed": "node --env-file=../../.env --experimental-sqlite --import tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --import tsx --test 'tests/**/*.test.ts' 'tests/**/*.test.tsx'",
    "demo": "node --experimental-sqlite --import tsx src/demo.tsx"
  },
  "dependencies": {
    "@copilotkit/channels": "0.9.2",
    "@copilotkit/runtime": "1.70.3",
    "agent-core": "*",
    "zod": "^4.1.0"
  }
}
